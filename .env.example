# Amazon Bedrock model discovery configuration
# Copy this file to .env and fill in your values.
#
# There is no API key: the CLI authenticates with standard AWS credentials
# (SigV4). Any credential source boto3 understands works - SSO, env vars,
# instance profiles, and so on.

# Named AWS profile to use (optional - the default credential chain is used
# when unset). Can also be passed per command with --profile.
AWS_PROFILE=my-profile

# Region to query for models (optional if the profile configures one).
# Can also be passed per command with --region.
AWS_REGION=us-east-1
